{
  "name": "Voxi",
  "mode": "dark",
  "note": "Canonical source: Claude Design project 04c2c697-7d00-4108-a3cb-a877952d0004, 'Voxi Desktop.dc.html', as implemented in apps/web. Mint is the agent's colour and marks anything Voxi does or says; lime marks a finished thing; paper marks anything that needs the Subscriber. Never use mint for generic emphasis — it stops meaning anything.",

  "color": {
    "surface": {
      "canvas": "#070a09",
      "bg": "#0b0f0d",
      "surface": "#131916",
      "surface2": "#1a211e",
      "surface3": "#242d29"
    },
    "line": {
      "subtle": "#171e1b",
      "default": "#242d29",
      "strong": "#31403a",
      "control": "#3a443f"
    },
    "mint": {
      "base": "#0aef9a",
      "hover": "#3df2ae",
      "deep": "#08c57f",
      "tint": "rgba(10,239,154,.07)",
      "chip": "rgba(10,239,154,.14)",
      "line": "rgba(10,239,154,.40)",
      "lineSoft": "rgba(10,239,154,.28)",
      "inkMuted": "#065a3b"
    },
    "lime": {
      "base": "#8cdd2c",
      "tint": "rgba(140,221,44,.08)",
      "line": "rgba(140,221,44,.35)"
    },
    "paper": {
      "base": "#e8e4d6",
      "ink": "#0b0f0d",
      "inkMuted": "#5e5a4e"
    },
    "text": {
      "primary": "#ffffff",
      "secondary": "#a9afac",
      "tertiary": "#8a918e",
      "muted": "#6b7370",
      "faint": "#4d5551",
      "danger": "#fca5a5"
    }
  },

  "font": {
    "sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", system-ui, sans-serif",
    "mono": "ui-monospace, Menlo, monospace"
  },

  "type": {
    "hero":     { "size": 34, "line": 42, "weight": 700, "tracking": -0.8, "use": "one-thing-at-a-time screens" },
    "display":  { "size": 32, "line": 38, "weight": 700, "tracking": -0.6, "use": "screen title" },
    "title":    { "size": 30, "line": 38, "weight": 700, "tracking": -0.6, "use": "detail screen subject" },
    "speech":   { "size": 26, "line": 37, "weight": 600, "tracking": -0.4, "use": "the orb talking" },
    "lead":     { "size": 18, "line": 25, "weight": 600, "tracking": 0,    "use": "card subject" },
    "bodyLg":   { "size": 17, "line": 24, "weight": 500, "tracking": 0 },
    "body":     { "size": 15, "line": 22, "weight": 400, "tracking": 0,    "use": "default" },
    "bodySm":   { "size": 14, "line": 21, "weight": 400, "tracking": 0 },
    "meta":     { "size": 13, "line": 22, "weight": 400, "tracking": 0,    "use": "timestamps, source lines" },
    "button":   { "size": 16, "line": 16, "weight": 700, "tracking": 0 },
    "label":    { "size": 11, "line": 14, "weight": 700, "tracking": 1.2,  "transform": "uppercase" }
  },

  "radius": { "chip": 8, "sm": 14, "md": 16, "lg": 18, "card": 22, "cardLg": 24, "pill": 100, "device": 52, "panel": 6 },

  "space": [4, 7, 11, 14, 18, 22, 26, 34, 48],

  "elevation": {
    "ring": "0 0 0 1px #242d29",
    "lift": "0 40px 90px rgba(0,0,0,.6)",
    "glow": "radial-gradient(circle, rgba(10,239,154,.22), transparent 70%)"
  },

  "motion": {
    "pulse": { "duration": "1.4s", "easing": "ease-in-out", "stagger": "0.2s" }
  },

  "patterns": {
    "primaryButton": { "bg": "#0aef9a", "fg": "#0b0f0d", "radius": 18, "padding": "17px", "weight": 700 },
    "secondaryButton": { "bg": "#131916", "fg": "#a9afac", "border": "#242d29", "radius": 18, "padding": "17px", "weight": 600 },
    "agentButton": { "bg": "rgba(10,239,154,.07)", "fg": "#0aef9a", "border": "rgba(10,239,154,.30)", "radius": 16, "note": "outlined mint = Voxi does it; flat = you do it" },
    "card": { "bg": "#131916", "border": "#242d29", "radius": 6, "padding": "28px 30px" },
    "agentCard": { "bg": "#0aef9a", "fg": "#0b0f0d", "radius": 6, "padding": "28px 30px", "note": "flat mint fill — Voxi is live/active right now, not a generic 'agent-owned' card" },
    "paperCard": { "bg": "#e8e4d6", "fg": "#0b0f0d", "fgMuted": "#5e5a4e", "radius": 6, "padding": "28px 30px", "note": "anything that needs the Subscriber — a Task or an Input Request alike" },
    "listRow": { "borderBottom": "#171e1b", "padding": "16px 0" },
    "factRow": { "keyWidth": 74, "keyColor": "#4d5551", "valueColor": "#ffffff", "padding": "14px 0", "borderBottom": "#171e1b" }
  },

  "desktop": {
    "note": "Device radius (52) and the 44px hit-target floor are phone-only. Body size does not scale up; headings do.",
    "contentWidth": [560, 720],
    "typeScale": { "hero": 44, "display": 38, "title": 34, "body": 15, "meta": 13 },
    "hitTarget": 32
  }
}
